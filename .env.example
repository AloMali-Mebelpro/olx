# Postgres connection string. On Vercel: add the "Postgres" storage
# integration to your project and this is filled in automatically.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Vercel Blob storage for user-uploaded listing photos. On Vercel: add the
# "Blob" storage integration and this is filled in automatically. Without it,
# uploads are written to the local public/uploads folder (dev only).
BLOB_READ_WRITE_TOKEN=""

# Google Maps address picker. Get a key at https://console.cloud.google.com/google/maps-apis
# and enable "Maps JavaScript API". Without it, the address form falls back
# to manual lat/lng inputs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Stripe (payments for promoting listings to the top). Get test keys at
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Used to build absolute Stripe redirect URLs. Defaults to the request origin
# if unset. Set this to your production domain once deployed.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
